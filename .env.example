# Environment Configuration Template
# Salin berkas ini menjadi '.env' jika ingin menyesuaikan konfigurasi default secara lokal.

# ESP32 Access Point Configuration
ESP32_HOST=192.168.4.1
ESP32_PORT=5000
ESP32_WIFI_SSID=SmartPlant_Paket2
ESP32_WIFI_PASS=monitoring32

# Local Web Server Configuration (Model 2)
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# MQTT Broker Configuration (Model 3)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=esp32-bridge-wmlta
MQTT_TOPIC_PREFIX=smartplant
